# Copy to .env and adjust. Every value has a default, so for the fully local
# setup (Ollama + Qdrant in Docker) you can run without a .env file at all.

# ---------------------------------------------------------------------------
# Branding
# ---------------------------------------------------------------------------
APP_NAME="Nestora Assistant"
KB_NAME="Nestora Commerce"

# ---------------------------------------------------------------------------
# Option A: fully local (default). Needs `ollama serve` running.
#   ollama pull qwen3:8b && ollama pull nomic-embed-text
# ---------------------------------------------------------------------------
LLM_PROVIDER=ollama
LLM_MODEL=qwen3:8b
EMBED_PROVIDER=ollama
EMBED_MODEL=nomic-embed-text
OLLAMA_BASE_URL=http://localhost:11434
# Qwen3 and DeepSeek-R1 "think" before answering. Off = faster answers.
OLLAMA_THINK=false

# ---------------------------------------------------------------------------
# Option B: cloud models (for Vercel / Render). Any OpenAI-compatible API works.
# Uncomment ONE block and comment out Option A.
# ---------------------------------------------------------------------------

# --- Google Gemini for both chat and embeddings (one free API key) ---
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_API_KEY=your-gemini-api-key
# LLM_MODEL=gemini-2.5-flash
# EMBED_PROVIDER=openai
# EMBED_MODEL=gemini-embedding-001

# --- Groq for fast chat + Gemini for embeddings ---
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=your-groq-api-key
# LLM_MODEL=openai/gpt-oss-20b
# EMBED_PROVIDER=openai
# EMBED_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# EMBED_API_KEY=your-gemini-api-key
# EMBED_MODEL=gemini-embedding-001

# --- OpenAI ---
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini
# EMBED_PROVIDER=openai
# EMBED_MODEL=text-embedding-3-small

# Optional: ask the embedding API for shorter vectors (OpenAI text-embedding-3-*).
# EMBED_DIMENSIONS=768

# ---------------------------------------------------------------------------
# Vector database (pick one)
# ---------------------------------------------------------------------------
# Qdrant in Docker:  docker compose up -d qdrant
QDRANT_URL=http://localhost:6333
# Qdrant Cloud (free 1 GB cluster):
# QDRANT_URL=https://xxxxxxxx.region.cloud.qdrant.io
# QDRANT_API_KEY=your-qdrant-api-key
# Embedded mode, no server at all (local only; stop the server before ingesting):
# QDRANT_URL=
# QDRANT_PATH=./.qdrant

COLLECTION_NAME=knowledge_base

# ---------------------------------------------------------------------------
# Retrieval tuning
# ---------------------------------------------------------------------------
KB_DIR=knowledge_base
CHUNK_SIZE=900
CHUNK_OVERLAP=150
TOP_K=5
CANDIDATES=20
# Minimum cosine similarity. Lower it if good questions return no sources.
MIN_SCORE=0.35
HISTORY_TURNS=6
TEMPERATURE=0.2
MAX_TOKENS=1024

# ---------------------------------------------------------------------------
# Web server
# ---------------------------------------------------------------------------
CORS_ORIGINS=*
MAX_QUESTION_CHARS=2000
# Per client IP, per server instance. 0 turns it off.
RATE_LIMIT_PER_MINUTE=30
